# Database
DATABASE_NAME=krypteradb
DATABASE_USER=kryptera
DATABASE_PASSWORD=P@ssword123
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,kryptera.cc
# Required for Django admin login over HTTPS (comma-separated origins, no trailing slash)
CSRF_TRUSTED_ORIGINS=https://kryptera.cc,http://localhost
USE_X_FORWARDED_HOST=True
BEHIND_REVERSE_PROXY=True

# Django database admin UI: https://your-domain/admin/admin/
# (React app admin stays at /admin/dashboard, etc.)

# SMTP — Brevo transactional relay (https://app.brevo.com → SMTP & API → SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Must be a sender verified in Brevo (Senders & IPs); not the SMTP login address
DEFAULT_FROM_EMAIL=noreply@kryptera.cc
REPLY_TO_EMAIL=support@kryptera.cc

# Admin notification inboxes — comma or semicolon separated; each gets every KYC/POP alert
# ADMIN_NOTIFICATION_EMAILS=ops@example.com,finance@example.com,support@example.com
ADMIN_NOTIFICATION_EMAILS=ops@example.com,alerts@example.com

# Links in notification emails and CSRF origin (use your public HTTPS URL in production)
FRONTEND_URL=https://kryptera.cc

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
