# Database
DATABASE_NAME=krypteradb
DATABASE_USER=kryptera
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP (required for email notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@kryptera.com
REPLY_TO_EMAIL=support@kryptera.com

# Comma-separated admin inboxes (one email sent per address)
ADMIN_NOTIFICATION_EMAILS=ops@example.com

# Links in notification emails
FRONTEND_URL=http://localhost

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
